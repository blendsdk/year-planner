{
  "name": "year-planner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm --filter @blendsdk/year-planner-core build && pnpm --filter @blendsdk/react-year-planner build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "test:print": "playwright test --grep @print",
    "test:size": "node scripts/check-size.mjs",
    "test:consumer": "bash scripts/clean-consumer.sh",
    "dev": "pnpm --filter @blendsdk/year-planner-demo dev",
    "storybook": "pnpm --filter @blendsdk/year-planner-storybook storybook",
    "storybook:build": "pnpm --filter @blendsdk/year-planner-storybook build",
    "api-report": "node scripts/check-api.mjs",
    "pack:check": "pnpm -r pack:check",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm pack:check",
    "verify:full": "pnpm verify && pnpm test:e2e && pnpm test:consumer"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.65.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
