{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "files": {
    "includes": [
      "packages/**",
      "apps/**",
      "scripts/**",
      "tests/**",
      "spike/**",
      "!**/dist",
      "!**/coverage",
      "!spike/renderer/evidence",
      "!**/etc",
      "!**/temp",
      "!**/storybook-static",
      "!**/node_modules"
    ]
  },
  "overrides": [
    {
      "includes": ["packages/react/src/YearPlanner.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useFocusableInteractive": "off",
            "useAriaPropsSupportedByRole": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    }
  ]
}
