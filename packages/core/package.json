{
  "name": "@blendsdk/year-planner-core",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "description": "Pure TypeScript date, interval and classic year layout core for Year Planner for React",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blendsdk/year-planner.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "pack:check": "publint && attw --pack . --profile esm-only",
    "api-report": "api-extractor run --local --config api-extractor.json",
    "api-report:ci": "api-extractor run --config api-extractor.json"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "publint": "0.3.25",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "homepage": "https://github.com/blendsdk/year-planner#readme",
  "bugs": {
    "url": "https://github.com/blendsdk/year-planner/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
